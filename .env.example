# Copy to .env and fill in what you need. Everything here is optional —
# the site runs with an empty .env; the features noted below just stay off.

# ── ports ────────────────────────────────────────────────────────────────
API_PORT=8787
WEB_PORT=5173
# Used to build the password-reset link that goes out by email.
SITE_URL=http://localhost:8787

# ── admin account ────────────────────────────────────────────────────────
# Created on first boot. Leave ADMIN_PASSWORD unset and a random one is
# generated and printed to the console once — set it here to choose your own.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=
ADMIN_NAME=Site Admin

# Sign the browser in as ADMIN_EMAIL automatically, with no login step (default
# on). Pressing Log out still logs you out and stays out until you sign in
# again. Set to false to require a password — do that BEFORE exposing this
# server beyond localhost, because with it on anyone who can reach the port
# is an admin.
AUTO_LOGIN=true

# ── backups ──────────────────────────────────────────────────────────────
# The server backs up on boot and then on this interval. 0 disables the timer
# (the boot backup still runs). Backups land in backups/ and the oldest are
# pruned past BACKUP_KEEP.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=20
# Backups include .env by default. They sit inside OneDrive, so set this to
# false if you'd rather your API keys weren't synced to the cloud.
BACKUP_INCLUDE_ENV=true

# ── Met Office warnings ──────────────────────────────────────────────────
# How often to re-scrape the public warnings page. 0 disables the timer.
WARNINGS_REFRESH_MINUTES=60
# The local parser is deterministic and needs no key. Set this to true to run
# the Base44 original instead, which asks an LLM to read the page (needs
# ANTHROPIC_API_KEY below).
USE_ORIGINAL_WARNINGS=false

# ── weather data APIs ────────────────────────────────────────────────────
# All optional. The Location Weather page no longer needs any of them: it is
# served by server/functions/getMetOfficeLocationWeather.js, which fetches the
# Met Office's own model (ukmo_seamless) from Open-Meteo without a key. Set
# USE_ORIGINAL_LOCATION_WEATHER=true, with a real DataHub key below, to run the
# Base44 original against Met Office DataHub instead.
USE_ORIGINAL_LOCATION_WEATHER=false
MET_OFFICE_DATAHUB_API_KEY=
MET_OFFICE_ATMOSPHERIC_KEY=
MET_OFFICE_TCM_KEY=
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=

# ── AI forecast fallback (integrations.Core.InvokeLLM) ───────────────────
# Only used when the model data is unavailable. Unset = feature off.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# ── outbound email (integrations.Core.SendEmail) ─────────────────────────
# Unset = verification codes and reset links print to the server console
# instead of being emailed, which is fine for a single-operator install.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Gmail outlook alerts ─────────────────────────────────────────────────
# sendOutlookEmailAlert used a Base44-brokered Gmail connection. Paste an
# OAuth access token here to keep it working; otherwise it reports
# "Gmail not connected" and sends nothing.
GMAIL_ACCESS_TOKEN=

# ── frontend ─────────────────────────────────────────────────────────────
# Only set this if you serve the API from somewhere other than /api.
# VITE_API_BASE_URL=/api
