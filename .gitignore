node_modules/
dist/
.env
# Live data + uploads: yours, not part of the build.
server/data/db.json
server/data/db.json.tmp
server/data/db.json.corrupt-*
server/uploads/*
!server/uploads/.gitkeep
# Regenerated from server/base44-functions on every boot.
server/.functions-build/

# Local backups — your data, not part of the build.
backups/

# AI lightning warnings: live strike archive, warning state, audit log (contains
# admin email addresses) and trained models. Data, not source.
server/data/aiw/
# Raw GeoNames downloads — rebuild with server/data/geo/build-gazetteer.mjs.
# (gazetteer.json itself IS committed: the server needs it to run.)
server/data/geo/raw/
# Generated TCM V5 products.
server/data/tcm-v5/
# Scratch files.
f.txt
p_*.txt
.previous-home-build/
*.log
# Weather Scenarios admin edits + audit log (admin emails). Data, not source.
server/data/scenarios-local/
# Local Claude Code launch config.
.claude/
# Trusted-device key hashes for owner auto-login.
server/data/trusted-devices.json
# ECMWF ensemble member cache for the scenario graphic.
server/data/ens-cache/
# Storm-blend pipeline: local venv, downloaded model fields and outputs
tools/storm-blend/.venv/
tools/storm-blend/out-*.json
tools/storm-blend/*.pkl
tools/storm-blend/*.png
tools/storm-blend/*.npz
tools/storm-blend/videobase-*.jpg
# TCM NOVA: model data lives on D:/TCM-NOVA; never commit runs, caches or terrain
server/data/tcm-nova/
tools/tcm-nova/.cache/
tools/tcm-nova/.terrain.log
tools/tcm-nova/**/__pycache__/
tools/tcm-v3/.bundle.mjs
# Weather Patterns output and its download cache, when there is no D: drive (server/patterns).
server/data/patterns/
server/data/patterns-cache/
