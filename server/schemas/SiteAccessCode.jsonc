{
  "name": "SiteAccessCode",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email of the user this code belongs to"
    },
    "code": {
      "type": "string",
      "description": "The access code"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this code is valid"
    },
    "notes": {
      "type": "string",
      "description": "Admin notes"
    }
  },
  "required": [
    "email",
    "code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}