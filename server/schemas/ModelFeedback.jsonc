{
  "name": "ModelFeedback",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "description": "Forecast date (YYYY-MM-DD)"
    },
    "day_label": {
      "type": "string",
      "description": "e.g. Day 1, Day 2, Day 3"
    },
    "forecast_risk": {
      "type": "string",
      "description": "What the model predicted (e.g. Slight, Moderate)"
    },
    "actual_outcome": {
      "type": "string",
      "enum": [
        "No storms",
        "Isolated",
        "Scattered",
        "Widespread",
        "Severe"
      ],
      "description": "What actually happened"
    },
    "accuracy_rating": {
      "type": "number",
      "description": "1-5 star accuracy rating"
    },
    "notes": {
      "type": "string",
      "description": "Manual notes about what occurred vs forecast"
    },
    "peak_lightning": {
      "type": "number",
      "description": "Peak lightning strikes observed"
    },
    "peak_region": {
      "type": "string",
      "description": "Region with highest activity"
    },
    "model_score": {
      "type": "number",
      "description": "The model's thunderstorm score at peak"
    },
    "bias_direction": {
      "type": "string",
      "enum": [
        "over-forecast",
        "accurate",
        "under-forecast"
      ],
      "description": "Was the model too high or too low?"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. Spanish Plume, Cold Front, Orographic"
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}