{
  "name": "SubscriptionMatrix",
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "description": "JSON blob holding the full subscription page config (tiers, products matrix, prices, API usage, badges). Single-record singleton edited via Admin Settings."
    }
  },
  "required": [
    "data"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}