# MyWeatherUK on the Oracle server (deploy/oracle): the settings that are not secret. The secret keys (Met Office
# and the rest) are in /srv/mwuk/app/.env, copied once from the PC; settings only this server should have go in
# /srv/mwuk/mwuk.local.env, read after this file.
NODE_ENV=production
API_PORT=8787
UV_THREADPOOL_SIZE=16

# Nobody is "the owner on this PC" here: no automatic admin sign-in (server/auth.js)
AUTO_LOGIN=false

# Where the data lives (on the PC each defaults to the D: drive)
MODELDATA_DIR=/srv/mwuk/data/modeldata
LIGHTNING_DIR=/srv/mwuk/data/lightning
AIW_TRAIN_STRIKES=/srv/mwuk/data/lightning/bz
NOVA_DATA=/srv/mwuk/data/tcm-nova/data
TCM_V3_DATA=/srv/mwuk/data/tcm-nova/tcm-v3
FROST_DATA=/srv/mwuk/data/frost
PATTERNS_DIR=/srv/mwuk/data/patterns
PATTERNS_CACHE=/srv/mwuk/data/patterns-cache
TCM_ARCHIVE=/srv/mwuk/data/tcm-archive
STUDIO_DATA=/srv/mwuk/data/studio
AIW_ENV_DIR=/srv/mwuk/data/aiw-env
ENS_CACHE=/srv/mwuk/data/ens-cache

# The Python with deploy/oracle/requirements.txt (setup.sh makes it)
ENS_PYTHON=/srv/mwuk/venv/bin/python
NOVA_PYTHON=/srv/mwuk/venv/bin/python

# A 2-core, 12 GB server: fewer Model Data workers, a smaller frame cache, and only the most-used layers made
# ahead of time (server/modelData.js and server/mdWorkers.js read these; unset on the PC)
MODELDATA_WORKERS_UK=2
MODELDATA_WORKERS_EU=2
MODELDATA_BG_WORKERS=1
MODELDATA_HOT_MB=400
MODELDATA_WARM=popular
